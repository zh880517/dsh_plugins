{
  "name": "@kinemesh/dsh-plugin",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "面向游戏 3D 模型/动画资源的 AI 预览与分析（动析）：kinemesh_info 提取动画/骨骼/网格信息，kinemesh_render 按视角渲染截图，kinemesh_analyze 动作分析（分段/循环/强度），kinemesh_skeleton 骨架识别与映射",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "viewer.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
